[Unit]
Description=Raspberry Pi Discord read-only monitor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/pi-discord-monitor
EnvironmentFile=/home/YOUR_USER/pi-discord-monitor/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/YOUR_USER/pi-discord-monitor/.venv/bin/python bot.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
